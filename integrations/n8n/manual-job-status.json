{
  "name": "OnSori manual job status",
  "nodes": [
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "configure",
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "base_url",
              "value": "https://CHANGE-ME.invalid",
              "type": "string"
            },
            {
              "id": "job-id",
              "name": "job_id",
              "value": "CHANGE_ME_JOB_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "validate-configuration",
      "name": "Validate configuration",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "startsWithhttps://",
              "leftValue": "={{ $json.base_url }}",
              "rightValue": "https://",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            },
            {
              "id": "notContainsCHANGE-ME",
              "leftValue": "={{ $json.base_url }}",
              "rightValue": "CHANGE-ME",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "regex^[A-Za-z0-9_-]{1,128}$",
              "leftValue": "={{ $json.job_id }}",
              "rightValue": "^[A-Za-z0-9_-]{1,128}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "notContainsCHANGE_ME",
              "leftValue": "={{ $json.job_id }}",
              "rightValue": "CHANGE_ME",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "id": "https-origin",
              "leftValue": "={{ $json.base_url }}",
              "rightValue": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "get-job",
      "name": "Get job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "url": "={{ $json.base_url + '/v1/jobs/' + $json.job_id }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false
    },
    {
      "id": "terminal-state",
      "name": "Terminal state",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "equalsdone",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "equalserror",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "equalscancelled",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "cancelled",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Validate configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate configuration": {
      "main": [
        [
          {
            "node": "Get job",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Get job": {
      "main": [
        [
          {
            "node": "Terminal state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
