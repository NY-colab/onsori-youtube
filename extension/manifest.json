{
  "manifest_version": 3,
  "name": "온소리 자막 in YouTube",
  "version": "0.3.3",
  "description": "YouTube 대사·음악·효과음을 기기 내 AI로 자막화합니다. 별도 프로그램 없이 소리 크기도 구간별 글자 크기로 표현합니다.",
  "options_page": "help.html",
  "homepage_url": "https://github.com/NY-colab/onsori-youtube",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.xethub.hf.co/*",
    "https://*.hf.co/*",
    "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "온소리 자막",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page-source.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "source-bridge.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core.js",
        "panel.js",
        "native-captions.js",
        "screen-frames.js",
        "controls.js",
        "panel-template.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src https://*.googlevideo.com https://www.youtube.com https://m.youtube.com 'self' data: blob: https://huggingface.co https://*.huggingface.co https://*.xethub.hf.co https://*.hf.co https://raw.githubusercontent.com"
  }
}
