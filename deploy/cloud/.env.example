# Copy to .env only on the approved host; use two distinct random tokens >=32 characters.
ONSORI_API_TOKEN=CHANGE_ME_ADMIN_TOKEN
ONSORI_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
ONSORI_PROVIDER=disabled
ONSORI_ALLOW_PAID=false
DEEPINFRA_API_KEY=
ONSORI_DATA_DIR=/data
ONSORI_MAX_QUEUE=4
ONSORI_DAILY_AUDIO_MINUTES=60
ONSORI_INSTALL_DAILY_AUDIO_MINUTES=20
ONSORI_INSTALLS_PER_IP_DAY=3
ONSORI_RESULT_TTL_SECONDS=86400
ONSORI_SWEEP_INTERVAL_SECONDS=60
ONSORI_PROVIDER_TIMEOUT_SECONDS=180
