# Generate two independent random secrets, each at least 32 characters.
ONSORI_API_TOKEN=
ONSORI_METRICS_TOKEN=
ONSORI_PROVIDER=disabled
ONSORI_ALLOW_PAID=false
DEEPINFRA_API_KEY=
ONSORI_DATA_DIR=/var/lib/onsori
ONSORI_MAX_QUEUE=4
ONSORI_DAILY_AUDIO_MINUTES=60
ONSORI_INSTALL_DAILY_AUDIO_MINUTES=20
ONSORI_INSTALLS_PER_IP_DAY=3
ONSORI_RESULT_TTL_SECONDS=86400
ONSORI_SWEEP_INTERVAL_SECONDS=60
ONSORI_PROVIDER_TIMEOUT_SECONDS=180
# Caption typo correction: caption text only, with the operator's provider key.
# disabled | mock | deepinfra | anthropic. deepinfra reuses DEEPINFRA_API_KEY above and does
# not need ONSORI_ALLOW_PAID (that switch is for audio). Set a spending limit at the provider first.
ONSORI_CORRECTION=disabled
# DeepInfra model id; empty means deepseek-ai/DeepSeek-V4-Flash-0731.
ONSORI_CORRECTION_MODEL=
# DeepInfra reasoning_effort: none (no reasoning) | minimal | low | medium | high, or default to omit it.
ONSORI_CORRECTION_REASONING=none
ANTHROPIC_API_KEY=
ONSORI_DAILY_CORRECTION_LINES=20000
ONSORI_INSTALL_DAILY_CORRECTION_LINES=3000
